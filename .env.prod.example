# Production Compose configuration (compose.prod.yaml). Copy to .env.prod on the server and
# do not commit .env.prod. Unlike .env.example, none of the "safe local default" values below
# exist here - most secrets are required with no fallback, so a missing value fails the deploy
# instead of silently running with a development credential.

# --- Image source (see docker-up-prod.sh, which pulls before it starts the stack) ---
# Lowercased GitHub org/user that owns this repo; matches the ghcr.io path release-image.yml
# publishes to. Only change this if the repo moves to a different owner.
GHCR_OWNER=repasscloud
IMAGE_NAME=license-server-app
# Pin an explicit released version (e.g. v0.3.1), not "latest": bumping this is how you
# deliberately roll the deployed version forward, one edit at a time.
IMAGE_TAG=replace-with-a-released-version-tag

# --- Database ---
POSTGRES_DB=license_server
POSTGRES_USER=license_app
# openssl rand -base64 24
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# --- Initial admin seed. Off by default in prod; flip on for exactly the first start, then
# set SEED_DEFAULT_ADMIN back to false. ---
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_EMAIL=replace-with-real-admin-email
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-random-password
SEED_DEMO_LICENSE=false

# IANA business timezone used only for the date embedded in generated license IDs.
LICENSE_ID_TIME_ZONE=Australia/Adelaide

# Generate each pepper independently; never reuse a pepper between credential classes.
# openssl rand -base64 32
ACTIVATION_CODE_PEPPER=replace-with-32-random-bytes-as-base64
API_CREDENTIAL_PEPPER=replace-with-another-32-random-bytes-as-base64
DEPLOYMENT_KEY_PEPPER=replace-with-yet-another-32-random-bytes-as-base64

# --- MailerSend ---
MAILERSEND_API_TOKEN=replace-with-mailersend-api-token
MAILERSEND_FROM_EMAIL=licenses@example.com
MAILERSEND_FROM_NAME=License Server
# openssl rand -hex 24
MAILERSEND_WEBHOOK_SECRET=replace-with-mailersend-webhook-signing-secret

# --- Stripe ---
STRIPE_API_KEY=replace-with-restricted-stripe-api-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-endpoint-secret
BILLING_GRACE_PERIOD_DAYS=7
BILLING_REFUND_ACTION=review
BILLING_DISPUTE_ACTION=review

# Public HTTPS origin used to build customer magic links in email. Keep this in sync with
# CADDY_DOMAIN below (https://<CADDY_DOMAIN>).
CUSTOMER_PORTAL_PUBLIC_BASE_URL=https://licenses.example.com

# Trusts exactly the app<->caddy Docker network compose.prod.yaml pins; only change this if you
# also change that network's subnet.
FORWARDED_HEADERS_KNOWN_NETWORK=172.28.0.0/24

# One-time local recovery switch. Set true for one restart, then immediately restore false.
RESET_ADMIN_PASSWORD=false

# Host path to the key-ring directory; compose.prod.yaml mounts it read-only at
# /var/lib/licenseserver/keys. Populate it with "<keyId>.private.pem" / "<keyId>.public.pem"
# pairs - generate a real production key pair, do not reuse the repo's PoC dev keys.
LICENSE_SIGNING_KEY_DIR=/opt/license-server/keys
# keyId of the SigningKeys row seeded as the initial default the first time the database has
# none marked default. Ignored afterward: rotate the live default via the admin UI's
# "Set as default" action instead, not by changing this value.
LICENSE_DEFAULT_SIGNING_KEY=replace-with-your-production-key-id

# --- Cloudflare R2 (invoice PDF storage) ---
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=license-server-invoices

# --- Invoice issuer details (embedded in generated invoice PDFs) ---
INVOICE_BUSINESS_NAME=replace-with-legal-business-name
INVOICE_BUSINESS_ADDRESS=replace-with-business-address
INVOICE_BUSINESS_ABN=replace-with-abn
INVOICE_BUSINESS_EMAIL=replace-with-billing-email

# --- Caddy / TLS ---
# The public domain this server answers on; Caddy requests and renews its certificate for it
# automatically. DNS must already point at this host on 80/tcp and 443/tcp before starting, or
# certificate issuance will fail.
CADDY_DOMAIN=licenses.example.com
# Used only for Let's Encrypt renewal/expiry notices, not for anything customer-facing.
CADDY_EMAIL=replace-with-an-email-you-monitor
