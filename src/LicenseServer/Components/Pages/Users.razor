@page "/settings/users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permissions.UsersRead)]
@inject UserAdministrationService UserService
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject IAuthorizationService AuthorizationService

<PageTitle>Users</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Security</p><h1>Operators and service accounts</h1><p>Invite people, create non-interactive automation identities, inspect roles and permissions, and revoke access.</p></div></div>

@if (message is not null) { <div class="alert @(isError ? "error" : "success")" role="status">@message</div> }
@if (showMfaRequiredNotice) { <div class="alert error" role="status">Managing users requires multi-factor authentication on your account. <a href="/Account/Manage/TwoFactorAuthentication">Enable MFA</a> to unlock these actions.</div> }

<form method="get" class="filters"><label>Search<input name="search" value="@Search" placeholder="Email or account type" /></label><button class="button secondary" type="submit">Search</button></form>

<AuthorizeView Policy="@Permissions.UsersManage"><Authorized Context="createPermissionContext">
    <article class="panel form-panel"><h2>Add identity</h2>
        <EditForm Model="create" FormName="create-user" OnValidSubmit="CreateAsync"><DataAnnotationsValidator /><ValidationSummary />
            <div class="form-grid"><label>Email<InputText @bind-Value="create.Email" /></label><label>Type<select @bind="create.AccountType"><option value="human">Human operator</option><option value="service">Service account</option></select></label><label>Role<select @bind="create.Role">@foreach (var role in BuiltInRoles.All) { <option value="@role">@role</option> }</select></label></div>
            <button class="button" type="submit">@(create.AccountType == ApplicationUser.ServiceAccountType ? "Create service account" : "Create invitation")</button>
        </EditForm>
    </article>
</Authorized></AuthorizeView>

<div class="table-wrap"><table><thead><tr><th>Identity</th><th>Type</th><th>Status</th><th>Roles and permissions</th><th>MFA</th><th></th></tr></thead><tbody>
@foreach (var user in items)
{
    <tr><td><strong>@user.Email</strong><br /><code>@user.Id</code></td><td>@user.AccountType</td><td>@(user.IsEnabled ? "Enabled" : "Disabled")</td><td>@string.Join(", ", user.Roles)<br /><small>@string.Join(", ", user.Permissions)</small></td><td>@(user.AccountType == ApplicationUser.ServiceAccountType ? "Not interactive" : user.MfaEnabled ? "Enabled" : "Not enabled")</td><td>
        <AuthorizeView Policy="@Permissions.UsersManage"><Authorized Context="rowPermissionContext"><button class="button @(user.IsEnabled ? "danger" : "secondary")" type="button" @onclick="() => ToggleAsync(user)">@(user.IsEnabled ? "Disable" : "Enable")</button>@if (user.AccountType == ApplicationUser.HumanAccountType) { <button class="button secondary" type="button" @onclick="() => ResetAsync(user)">Force password setup</button> }</Authorized></AuthorizeView>
    </td></tr>
}
</tbody></table></div>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    private IReadOnlyList<UserView> items = [];
    private readonly UserForm create = new();
    private string? message;
    private bool isError;
    private bool showMfaRequiredNotice;

    protected override async Task OnParametersSetAsync()
    {
        items = await UserService.SearchAsync(Search);
        var user = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        var hasPermission = user.HasClaim(Permissions.ClaimType, Permissions.UsersManage);
        var authorized = (await AuthorizationService.AuthorizeAsync(user, Permissions.UsersManage)).Succeeded;
        showMfaRequiredNotice = hasPermission && !authorized;
    }
    private async Task<string> ActorAsync() => (await AuthenticationState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";

    private async Task CreateAsync() => await ExecuteAsync(async () =>
    {
        if (create.AccountType == ApplicationUser.ServiceAccountType)
        {
            await UserService.CreateServiceAccountAsync(new(create.Email, [create.Role]), await ActorAsync());
            message = "Service account created. Create its scoped API key separately.";
        }
        else
        {
            var result = await UserService.InviteHumanAsync(new(create.Email, [create.Role]), await ActorAsync(), new Uri(Navigation.BaseUri));
            message = result.DevelopmentSetupUrl is null ? "Invitation queued." : $"Development-only setup link (shown once): {result.DevelopmentSetupUrl}";
        }
        create.Email = "";
    });

    private async Task ToggleAsync(UserView user) => await ExecuteAsync(async () =>
    {
        await UserService.SetEnabledAsync(user.Id, !user.IsEnabled, await ActorAsync());
        message = user.IsEnabled ? "User disabled and sessions revoked." : "User enabled.";
    });

    private async Task ResetAsync(UserView user) => await ExecuteAsync(async () =>
    {
        var result = await UserService.InitiatePasswordResetAsync(user.Id, await ActorAsync(), new Uri(Navigation.BaseUri));
        message = result.DevelopmentSetupUrl is null ? "Password setup queued." : $"Development-only setup link (shown once): {result.DevelopmentSetupUrl}";
    });

    private async Task ExecuteAsync(Func<Task> action)
    {
        message = null; isError = false;
        try { await action(); }
        catch (InvalidOperationException exception) { message = exception.Message; isError = true; }
        items = await UserService.SearchAsync(Search);
    }

    private sealed class UserForm
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress] public string Email { get; set; } = "";
        public string AccountType { get; set; } = ApplicationUser.HumanAccountType;
        public string Role { get; set; } = BuiltInRoles.Auditor;
    }
}
