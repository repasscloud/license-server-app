{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=license_server;Username=license_app"
  },
  "Licensing": {
    "IdTimeZone": "Australia/Adelaide",
    "KeyDirectory": "../../keys",
    "DefaultSigningKey": "primary-2026"
  },
  "ActivationCodes": {
    "IdempotencyWindowMinutes": 5
  },
  "ApiCredentials": {
    "LastUsedWriteIntervalMinutes": 5
  },
  "Email": {
    "WorkerEnabled": true
  },
  "Billing": {
    "WorkerEnabled": true,
    "BatchSize": 10,
    "MaxAttempts": 8,
    "LeaseSeconds": 120,
    "GracePeriodDays": 7,
    "RefundAction": "review",
    "DisputeAction": "review"
  },
  "Stripe": {
    "ApiVersion": "2026-07-29.dahlia"
  },
  "MailerSend": {
    "FromName": "License Server"
  },
  "CustomerPortal": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Invoice": {
    "TaxLabel": "GST"
  },
  "Security": {
    "UseHttpsRedirection": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
