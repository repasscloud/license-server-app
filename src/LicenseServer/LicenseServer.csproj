<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Version is overridden by CI (-p:Version=X.Y.Z) at release build/pack time; this is only
         the local/dev fallback so an unversioned build still produces something sane. -->
    <Version>0.3.5</Version>
    <PackageId>LicenseServer</PackageId>
    <Authors>RePass Cloud Pty Ltd</Authors>
    <Company>RePass Cloud Pty Ltd</Company>
    <Copyright>Copyright 2026 Danijel-James Wynyard</Copyright>
    <Description>Licence server: issues, tracks, and validates licences over HTTP.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/repasscloud/license-server-app</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Licensing.Core\Licensing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the templates load by assembly resource regardless of the process's
         working directory or publish layout (test host, container, etc). -->
    <EmbeddedResource Include="EmailTemplates\*.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LicenseServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

</Project>
